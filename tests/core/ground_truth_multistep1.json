{
  "name": "multistep1_toJson_pyapi_py",
  "yaml_inputs": {
    "touch~filename": "empty.txt",
    "append~str": "Hello"
  },
  "steps": [
    {
      "id": "touch",
      "in": {
        "filename": {
          "source": "touch~filename"
        }
      },
      "run": {
        "class": "CommandLineTool",
        "requirements": {
          "DockerRequirement": {
            "dockerPull": "docker.io/library/debian:bookworm-slim"
          },
          "InlineJavascriptRequirement": {}
        },
        "baseCommand": "touch",
        "inputs": {
          "filename": {
            "type": "string",
            "inputBinding": {
              "position": 1
            }
          }
        },
        "outputs": {
          "file": {
            "type": "File",
            "outputBinding": {
              "glob": "$(inputs.filename)"
            }
          }
        },
        "hints": {
          "LoadListingRequirement": {
            "loadListing": "deep_listing"
          },
          "NetworkAccess": {
            "networkAccess": true
          }
        }
      },
      "out": [
        "file"
      ]
    },
    {
      "id": "append",
      "in": {
        "str": {
          "source": "append~str"
        },
        "file": {
          "source": "touch/file"
        }
      },
      "run": {
        "class": "CommandLineTool",
        "requirements": {
          "ShellCommandRequirement": {},
          "InlineJavascriptRequirement": {},
          "InitialWorkDirRequirement": {
            "listing": [
              "$(inputs.file)"
            ]
          }
        },
        "inputs": {
          "str": {
            "type": "string",
            "inputBinding": {
              "shellQuote": false,
              "position": 1,
              "prefix": "echo"
            }
          },
          "file": {
            "type": "File",
            "inputBinding": {
              "shellQuote": false,
              "position": 2,
              "prefix": ">>"
            }
          }
        },
        "outputs": {
          "file": {
            "type": "File",
            "outputBinding": {
              "glob": "$(inputs.file.basename)"
            }
          }
        },
        "hints": {
          "LoadListingRequirement": {
            "loadListing": "deep_listing"
          },
          "NetworkAccess": {
            "networkAccess": true
          }
        }
      },
      "out": [
        "file"
      ]
    },
    {
      "id": "cat",
      "in": {
        "file": {
          "source": "append/file"
        }
      },
      "run": {
        "class": "CommandLineTool",
        "requirements": {
          "DockerRequirement": {
            "dockerPull": "docker.io/library/debian:bookworm-slim"
          },
          "InlineJavascriptRequirement": {}
        },
        "baseCommand": [
          "cat"
        ],
        "inputs": {
          "file": {
            "type": "File"
          }
        },
        "outputs": {
          "output": {
            "type": "string",
            "outputBinding": {
              "glob": "output",
              "loadContents": true,
              "outputEval": "$(self[0].contents)"
            }
          }
        },
        "stdin": "$(inputs.file.path)",
        "stdout": "output",
        "hints": {
          "LoadListingRequirement": {
            "loadListing": "deep_listing"
          },
          "NetworkAccess": {
            "networkAccess": true
          }
        }
      },
      "out": [
        "output"
      ]
    }
  ],
  "cwlVersion": "v1.2",
  "class": "Workflow",
  "inputs": {
    "touch~filename": {
      "type": "string"
    },
    "append~str": {
      "type": "string"
    }
  },
  "outputs": {
    "touch~file": {
      "type": "File",
      "outputSource": "touch/file"
    },
    "append~file": {
      "type": "File",
      "outputSource": "append/file"
    },
    "cat~output": {
      "type": "string",
      "outputSource": "cat/output"
    }
  }
}