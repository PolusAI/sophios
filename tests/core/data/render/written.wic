# A document in every spelling, which the renderer writes as rendered.wic: each construct tagged, each literal
# spelled as it was written, every step's wic: block in the wrapper it was read through, and an empty one as {}.
wic:
  steps:
    (1, s):
      wic:
        namespace: dna
    (2, t):
      wic: {}
steps:
- id: s
  in:
    a: {wic_inline_input: x}
    b: {wic_alias: e}
    c: {wic_raw_cwl: a/b}
    d: {wic_raw_cwl: {source: {wic_alias: a}, valueFrom: $(self)}}
    e: !cwl {source: [!* a, b], linkMerge: merge_flattened, default: [1]}
    f: !cwl {source: [a], linkMerge: merge_nested}
    g: {wic_inline_input: '0'}
    h: {wic_inline_input: 'true'}
    i: !ii {a: !* e}
    j: !ii 0777
    k: !ii 1.50
    l: !ii yes
    m: !ii 0x1f
    n: !ii 1:30
    o: !ii +5
    p: !ii 00
    q: !ii 1.0e+300
    r: !ii .inf
    s: !ii .nan
    t: !ii on
    u: !ii 2020-01-01
    v: !ii null
    w: !ii '0'
    x: !ii ''
    y: !ii 'a b'
  out:
  - f:
      wic_anchor: e
  - g
- id: t
meta: !ii {a: 1}
