# `!* e` above its `!& e` is wic025: resolving it by pre-scanning every definition would make Lower accept a document
# the compiler refuses. A name defined twice is reported, and a `wic:` sidecar `out:` entry, inert passthrough as
# basic.wic relies on, neither defines it a second time nor masks the real duplicate.
wic:
  steps:
    (2, a):
      out:
      - f: {wic_anchor: e}
steps:
- id: use
  in:
    f: !* e
- id: a
  out:
  - f: !& e
- id: b
  out:
  - f: !& e
- id: record_use      # a record's `!*` source resolves as a bare one does
  in:
    f: !cwl {source: !* later}
- id: mk
  out:
  - file: !& later
