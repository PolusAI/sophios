# What the wic: block says about steps: each key names a step, as (index, name) or by its id, once, and holds only
# what the block may say about a step.
wic:
  steps:
    not a key: {}
    (1, a): {}
    (1, a): {}
    (2, s):
      scatterMethod: dot
      nonsense_key: 1
    (3, t):
      wic:
        inlineable: 1
        nonsense_key: 1
        graphviz: x
    (4, u): 3                    # what is said about a step is a mapping
steps:
- id: s
