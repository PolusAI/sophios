$namespaces:
  cwltool: http://commonwl.org/cwltool#

# The secret is a declared workflow input, so the hint below names it directly.
# The default is an example value; supply a real one with --inputs_file.
inputs:
  message:
    type: string
    default: raspberries!123

hints:
  cwltool:Secrets:
    secrets:
    - message

steps:
  echo:
    in:
      message: message
