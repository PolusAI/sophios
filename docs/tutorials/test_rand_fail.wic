steps:
  array_float:
    in:
      minval: !ii 0.9
      maxval: !ii 1
      step: !ii 0.01
      decimal_places: !ii 2
    out:
    - array: !& arr_float
  fail.wic:
    scatter: [with_probability]
    in:
      with_probability: !* arr_float
  echo:
    scatter: [message]
    in:
      message: !* out_thing